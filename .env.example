# Copy to .env.local and fill in. Validated by src/env.ts at build time.
# Set SKIP_ENV_VALIDATION=1 to bypass (e.g. lint-only tooling).

# Server-only
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CONTACT_TO_EMAIL=hello@aionconsults.com
# Optional. Must be on a domain verified in Resend (default: Resend's test sender).
# CONTACT_FROM_EMAIL=AION Consultancy <hello@aionconsults.com>
# Optional. 1 = log emails instead of sending and skip Turnstile (never in production).
# CONTACT_TEST_MODE=1

# Exposed to the browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_SITE_URL=http://localhost:3000
